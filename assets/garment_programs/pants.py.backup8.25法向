from copy import deepcopy
import numpy as np

import pygarment as pyg
from assets.garment_programs.base_classes import BaseBottoms
from assets.garment_programs import bands


class FrontPlacket(pyg.Component):
    def __init__(self, name, width=4.0, height=10.0):
        super().__init__(name)
        self.panel = pyg.Panel(f'{name}_panel')

        top_left = [0, 0]
        top_right = [width, 0]
        bottom_right = [width, height]
        bottom_left = [0, height]

        top_edge = pyg.Edge(top_left, top_right)
        right_edge = pyg.Edge(top_right, bottom_right)
        bottom_edge = pyg.Edge(bottom_right, bottom_left)
        left_edge = pyg.Edge(bottom_left, top_left)

        self.panel.edges = pyg.EdgeSequence(
            top_edge,
            right_edge,
            bottom_edge,
            left_edge
        ).close_loop()

        self.panel.interfaces['attach'] = pyg.Interface(
            self.panel,
            pyg.EdgeSequence(right_edge)
        )
        self.interfaces = {'attach': self.panel.interfaces['attach']}
        self.width = width
        self.height = height


class PantPanel(pyg.Panel):
    def __init__(
            self, name, body, design, 
            length,
            waist, 
            hips,
            hips_depth,
            crotch_width,
            dart_position,
            match_top_int_to=None,
            hipline_ext=1,
            double_dart=False, 
            is_front=False,            
            front_drop=0.0,            
            side_seam_tilt_angle=0.0,  
            front_dart_count=0,        
            front_dart_width=2.0,      
            front_dart_depth=6.0,      
            front_dart_position=0.5,   
            back_dart_count=2,         
            back_dart_width=2.5,       
            back_dart_depth=8.0,       
            back_dart_position=0.5,    
            semantic_label=None
    ) -> None:  
        """
            Basic pant panel with option to be fitted (with darts)
        """
        super().__init__(name)
        # 保存 semantic_label
        self.semantic_label = semantic_label

        flare = body['leg_circ'] * (design['flare']['v']  - 1) / 4 
        hips_depth = hips_depth * hipline_ext

        back_raise = 0.0
        back_inclination_deg = design.get('back_inclination', {}).get('v', 10)
        back_inclination_rad = np.deg2rad(back_inclination_deg)
        back_waist_trans = design.get('back_waist_trans', {}).get('v', 0.0)
        waist_trans = back_waist_trans if not is_front else 0.0
        hip_side_incl = np.deg2rad(body['_hip_inclination'])
        
        crotch_depth_diff = body['crotch_hip_diff']
        crotch_extention = crotch_width

        w_diff = hips - waist
        hw_shift = np.tan(hip_side_incl) * hips_depth
        if hw_shift > w_diff:
            hw_shift = w_diff

        # --- Edges definition ---
        if pyg.utils.close_enough(design['flare']['v'], 1):
            right_bottom = pyg.Edge([-flare, 0], [0, length])
        else:
            right_bottom = pyg.CurveEdgeFactory.curve_from_tangents(
                [-flare, 0], [0, length],
                target_tan1=np.array([0, 1]),
                initial_guess=[0.75, 0]
            )
        
        # ---- 后片结构 ----
        back_panel_outward_shift = 2.5 if not is_front else 0.0
        hip_line_y = length
        fixed_hip_length = body['waist'] / 2.9
        point2 = [hips, hip_line_y]
        point1 = [point2[0] - fixed_hip_length, hip_line_y]
        
        # 注意：waistline_shift只影响腰线，不影响侧缝
        # 侧缝必须前后片完全一致，否则match_interfaces会细分边导致缝合错误
        waistline_shift = -3.0 if not is_front else 0.0

        # ---- 侧缝（两段式：right_bottom + right_top） ----
        # 前后片使用完全相同的侧缝结构，确保缝合时顶点映射正确
        # 关键：side_waist的X坐标必须相同，不包含waistline_shift的差异
        start_pt = right_bottom.end
        
        # 侧缝顶点：前后片使用相同的坐标
        # 注意：这里不包含waistline_shift，确保前后片侧缝长度一致
        side_seam_x = hw_shift  # 不使用waistline_shift
        side_waist = [side_seam_x, length + hips_depth]
        
        # 前后片都使用相同的侧缝结构：从臀围线到侧腰的直线
        right_top = pyg.Edge(start_pt, side_waist)
        right_bottom_combined = right_bottom

        # ---- 腰线 ----
        # 腰线起点必须与side_waist相同，确保侧缝和腰线连接
        # 后片的waistline_shift通过腰线曲线的控制点来体现，而不是移动top_start
        top_start = [side_waist[0] + waist_trans, side_waist[1]]

        if is_front:
            top_end_y = length + hips_depth - front_drop
        else:
            top_end_y = length + hips_depth + back_raise

        # ---- 后片裆部 + 腰线 ----
        if not is_front:
            back_rise_tilt_deg = 20
            back_rise_tilt_rad = np.deg2rad(back_rise_tilt_deg)
            
            crotch_start_x = point2[0] + waistline_shift
            crotch_start_y = top_end_y + 1.2
            top_end = [crotch_start_x - 0.15, crotch_start_y]
            
            mid_x = (top_start[0] + top_end[0]) / 2
            mid_y = (top_start[1] + top_end[1]) / 2
            sag = back_raise * 0.5
            
            cp1_waist = [top_start[0] * 0.6 + top_end[0] * 0.4, mid_y - sag]
            cp2_waist = [top_end[0] + 1.5, top_end[1] + back_raise]
            top = pyg.CurveEdge(top_start, top_end, [cp1_waist, cp2_waist], relative=False)
            
            crotch_start = list(top_end)
            crotch_end = [hips + crotch_extention, length - crotch_depth_diff]
            crotch_len = np.linalg.norm(np.array(crotch_end) - np.array(crotch_start))
            
            cp1_distance = crotch_len * 0.02
            cp1_x = crotch_start[0] - np.sin(back_rise_tilt_rad) * cp1_distance
            cp1_y = crotch_start[1] - np.cos(back_rise_tilt_rad) * cp1_distance
            cp1 = [cp1_x, cp1_y]
            
            cp2_distance = crotch_len * 0.6
            cp2_x = crotch_end[0] - cp2_distance * 0.4
            cp2_y = crotch_end[1] - cp2_distance * 0.25
            cp2 = [cp2_x, cp2_y]
            
            crotch_curve = pyg.CurveEdge(crotch_start, crotch_end, [cp1, cp2], relative=False)
        else:
            top_end = [w_diff + waist, top_end_y]
            mid_x = (top_start[0] + top_end[0]) / 2
            mid_y = (top_start[1] + top_end[1]) / 2
            sag = front_drop * 1.2
            cp1 = [top_start[0] * 0.6 + top_end[0] * 0.4, mid_y - sag]
            cp2 = [top_start[0] * 0.4 + top_end[0] * 0.6, mid_y - sag]
            top = pyg.CurveEdge(top_start, top_end, [cp1, cp2], relative=False)
            
            crotch_top = pyg.Edge(top.end, [hips, length + 0.45 * hips_depth])
            crotch_bottom = pyg.CurveEdgeFactory.curve_from_tangents(
                crotch_top.end,
                [hips + crotch_extention, length - crotch_depth_diff],
                target_tan0=np.array([0, -1]),
                target_tan1=np.array([1, 0]),
                initial_guess=[0.5, -0.5]
            )
            crotch_curve = pyg.EdgeSequence(crotch_top, crotch_bottom)

        crotch_end_pt = crotch_curve.end if hasattr(crotch_curve, 'end') else crotch_curve[-1].end
        
        left = pyg.CurveEdgeFactory.curve_from_tangents(
            crotch_end_pt,
            [
                crotch_end_pt[0] - 2 + flare,
                y := min(0, length - crotch_depth_diff * 1.5)
            ],
            target_tan1=[flare, y - crotch_end_pt[1]],
            initial_guess=[0.3, 0]
        )

        self.edges = pyg.EdgeSequence(
            right_bottom_combined, right_top, top, crotch_curve, left
        ).close_loop()

        # ---- 为门襟创建接口 ----
        # 前后片都使用相同的分段结构，确保inside接口顶点映射正确
        placket_attach_segments = None
        inside_segments = None
        left_segments = left.subdivide_len([0.35, 0.30, 0.35])
        if is_front:
            placket_attach_segments = [left_segments[0], left_segments[1], left_segments[2]]
        inside_segments = [left_segments[0], left_segments[2]]
        self.edges.substitute(left, left_segments)
        bottom = self.edges[-1]

        self.set_pivot(crotch_end_pt)
        # 增加X方向间距，避免左右裤片在3D模拟时相互穿透
        # 右裤片X=-5, 左裤片mirror后X=5, 间距10cm
        self.translation = [-5.0, - hips_depth - crotch_depth_diff + 5, 0]

        # ---- 接口定义 ----
        # 恢复两段式侧缝接口，ruffle也恢复为2个值
        outside_ruffle = [1, hipline_ext]
        
        placket_attach_interface = None
        if is_front and placket_attach_segments is not None:
            placket_attach_interface = pyg.Interface(self, pyg.EdgeSequence(*placket_attach_segments))

        self.interfaces = {
            'outside': pyg.Interface(
                self,
                pyg.EdgeSequence(right_bottom_combined, right_top),
                ruffle=outside_ruffle),
            'crotch': pyg.Interface(self, crotch_curve),
            'inside': pyg.Interface(self, pyg.EdgeSequence(*inside_segments) if inside_segments else left),
            'bottom': pyg.Interface(self, bottom),
        }
        if placket_attach_interface is not None:
            self.interfaces['placket_attach'] = placket_attach_interface

        # ---- 省道 ----
        dart_width_raw = w_diff - hw_shift
        
        if is_front:
            dart_count = front_dart_count
            dart_width = front_dart_width if dart_count > 0 else 0
            dart_depth = front_dart_depth
            dart_pos_ratio = front_dart_position
        else:
            dart_count = back_dart_count
            dart_width = back_dart_width if dart_count > 0 else 0
            dart_depth = back_dart_depth
            dart_pos_ratio = back_dart_position
        
        max_total_dart_width = top.length() * 0.3
        if dart_count > 0:
            dart_width = min(dart_width, max_total_dart_width / dart_count)
        
        dart_position = dart_pos_ratio * top.length()
        dart_position = max(top.length() * 0.15, min(dart_position, top.length() * 0.85))

        if dart_count > 0:
            top_edges, int_edges = self.add_darts(
                top, dart_width, dart_depth, dart_position, dart_count=dart_count)
            self.interfaces['top'] = pyg.Interface(
                self, int_edges, 
                ruffle=waist / match_top_int_to if match_top_int_to is not None else 1.
            ) 
            self.edges.substitute(top, top_edges)
        else:
            self.interfaces['top'] = pyg.Interface(
                self, top, 
                ruffle=waist / match_top_int_to if match_top_int_to is not None else 1.
        )

    def add_darts(self, top, dart_width, dart_depth, dart_position, dart_count=1):
        top_len = top.length()
        dart_pos_ratio = dart_position / top_len if top_len > 0 else 0.3
        
        if dart_count == 2:
            side_seam_shift = 0
            dist_ratio = dart_pos_ratio * 0.5
            
            dart1_pos = top_len * (dart_pos_ratio + dist_ratio / 2 + dart_width / top_len / 2 + dart_width / top_len / 4 + side_seam_shift)
            dart2_pos = top_len * (dart_pos_ratio - dist_ratio / 2 + dart_width / top_len / 4 + side_seam_shift)
            
            offsets_mid = [-dart1_pos, -dart2_pos]
            darts = [
                pyg.EdgeSeqFactory.dart_shape(dart_width / 2, dart_depth * 0.9),
                pyg.EdgeSeqFactory.dart_shape(dart_width / 2, dart_depth)
            ]
        else:
            offsets_mid = [-dart_position - dart_width / 2]
            darts = [pyg.EdgeSeqFactory.dart_shape(dart_width, dart_depth)]
        
        top_edges, int_edges = pyg.EdgeSequence(top), pyg.EdgeSequence(top)

        for off, dart in zip(offsets_mid, darts):
            left_edge_len = top_edges[-1].length()
            offset = left_edge_len + off
            min_offset = dart_width / 2 + 0.5
            max_offset = left_edge_len - dart_width / 2 - 0.5
            if offset < min_offset:
                offset = min_offset
            elif offset > max_offset:
                offset = max_offset
            offset = max(0.5, min(offset, left_edge_len - 0.5))
            
            top_edges, int_edges = self.add_dart(
                dart,
                top_edges[-1],
                offset=offset,
                edge_seq=top_edges, 
                int_edge_seq=int_edges
            )

        return top_edges, int_edges
        

class PantsHalf(BaseBottoms):
    def __init__(self, body, design, tag='', rise=None, create_front_placket=True) -> None:
        super().__init__(body, design, tag, rise=rise)
        if 'pants' in design:
            design = design['pants']
        
        hip_adj_front = design.get('hip_adj_front', {}).get('v', -0.7)
        hip_adj_back  = design.get('hip_adj_back', {}).get('v', 0.7)
        self.rise = design['rise']['v'] if rise is None else rise
        waist, hips_depth, waist_back = self.eval_rise(self.rise)

        min_ext = body['leg_circ'] - body['hips'] / 2 + 5
        front_hip = (body['hips'] - body['hip_back_width']) / 2
        crotch_extention = min_ext * design['width']['v']  
        front_extention = front_hip / 4
        back_extention = crotch_extention - front_extention

        length, cuff_len = design['length']['v'], design['cuff']['cuff_len']['v']
        if design['cuff']['type']['v']: 
            if length - cuff_len < design['length']['range'][0]:
                cuff_len = length - design['length']['range'][0]
            length -= cuff_len
        length *= body['_leg_length']
        cuff_len *= body['_leg_length']

        side_seam_tilt = 0.0
        back_waist_trans = design.get('back_waist_trans', {}).get('v', 0.0)
        
        front_dart_count = design.get('front_dart_count', {}).get('v', 0)
        front_dart_width = design.get('front_dart_width', {}).get('v', 2.0)
        front_dart_depth = design.get('front_dart_depth', {}).get('v', 6.0)
        front_dart_position = design.get('front_dart_position', {}).get('v', 0.5)
        back_dart_count = design.get('back_dart_count', {}).get('v', 2)
        back_dart_width = design.get('back_dart_width', {}).get('v', 2.5)
        back_dart_depth = design.get('back_dart_depth', {}).get('v', 8.0)
        back_dart_position = design.get('back_dart_position', {}).get('v', 0.5)

        self.front = PantPanel(
            f'pant_f_{tag}', body, design,
            length=length,
            waist=(waist - waist_back) / 2,
            hips=(body['hips'] - body['hip_back_width']) / 2 + hip_adj_front,
            hips_depth=hips_depth,
            hipline_ext=1.1,
            dart_position=body['bum_points'] / 2,
            crotch_width=front_extention,
            match_top_int_to=(waist - waist_back) / 2,
            is_front=True,
            front_drop=1.0,
            front_dart_count=front_dart_count,
            front_dart_width=front_dart_width,
            front_dart_depth=front_dart_depth,
            front_dart_position=front_dart_position,
            back_dart_count=back_dart_count,
            back_dart_width=back_dart_width,
            back_dart_depth=back_dart_depth,
            back_dart_position=back_dart_position,
            semantic_label="LFP" if tag == 'l' else "RFP"
        ).translate_by([0, body['_waist_level'] - 5, 55])

        self.back = PantPanel(
            f'pant_b_{tag}', body, design,
            length=length,
            waist=waist_back / 2,
            hips=body['hip_back_width'] / 2 + hip_adj_back,
            hips_depth=hips_depth,
            hipline_ext=1.1,
            dart_position=body['bum_points'] / 2,
            crotch_width=back_extention,
            match_top_int_to=body['waist_back_width'] / 2,
            side_seam_tilt_angle=side_seam_tilt,
            front_dart_count=front_dart_count,
            front_dart_width=front_dart_width,
            front_dart_depth=front_dart_depth,
            front_dart_position=front_dart_position,
            back_dart_count=back_dart_count,
            back_dart_width=back_dart_width,
            back_dart_depth=back_dart_depth,
            back_dart_position=back_dart_position,
            semantic_label="LBP" if tag == 'l' else "RBP"
        ).translate_by([0, body['_waist_level'] - 5, -20])

        self.cuff = None
        if design['cuff']['type']['v']:
            self.cuff = bands.Cuff(
                f'cuff_{tag}',
                body,
                design['cuff'],
                length=cuff_len,
                top=self.front.interfaces['bottom'],
                bottom=self.back.interfaces['bottom']
            )

        # ---- 门襟（前片） ----
        self.front_placket = None
        placket_config = design.get('front_placket', {})
        if create_front_placket and placket_config.get('enabled', {}).get('v', False):
            placket_width = placket_config.get('width', {}).get('v', 4.0)
            placket_height = placket_config.get('height', {}).get('v', 10.0)
            distance_from_waist = placket_config.get('distance_from_waist', {}).get('v', 5.0)
            self.front_placket = FrontPlacket(
                f'front_placket_{tag}',
                width=placket_width,
                height=placket_height,
            )
            self.front_placket.place_by_interface(
                self.front_placket.interfaces['attach'],
                self.front.interfaces['placket_attach'],
                gap=0,
                alignment='top'
            )
            self.front_placket.translate_by([0, -distance_from_waist, 0])
            self.front_placket.translate_by([0, 0, 0.1])
            self.subs.append(self.front_placket)
            self.stitching_rules.append(
                (self.front_placket.interfaces['attach'], self.front.interfaces['placket_attach'])
            )

        # ---- 后贴袋（使用 surface_stitches） ----
        self.back_pocket = None
        self._pocket_config = None
        self._pocket_tag = tag
        self._pocket_body = self.body
        self._pocket_length = length
        if design.get('back_patch_pocket', {}).get('enabled', {}).get('v', False):
            self._pocket_config = design['back_patch_pocket']
            self._create_pocket()

        # ---- 前后片的缝合关系 ----
        # PantsHalf不缝合任何东西，所有缝合留给Pants类处理
        # 否则会导致顶点被多次缝合（MultiStitchingError）
        self.stitching_rules = pyg.Stitches()

        self._interfaces = {
            'top': pyg.Interface.from_multiple(self.front.interfaces['top'], self.back.interfaces['top']),
            'crotch': pyg.Interface.from_multiple(self.front.interfaces['crotch'], self.back.interfaces['crotch']),
            'outside': pyg.Interface.from_multiple(self.front.interfaces['outside'], self.back.interfaces['outside']),
            'inside': pyg.Interface.from_multiple(self.front.interfaces['inside'], self.back.interfaces['inside']),
            'bottom': pyg.Interface.from_multiple(self.front.interfaces['bottom'], self.back.interfaces['bottom'])
        }
        self.interfaces = self._interfaces

    def get_interfaces(self):
        return self._interfaces

    def _create_pocket(self):
        """创建后贴袋"""
        from assets.garment_programs.pockets import PatchPocket
        
        config = self._pocket_config
        tag = self._pocket_tag
        
        pocket_width = config.get('pocket_width', {}).get('v', 11)
        pocket_depth = config.get('pocket_depth', {}).get('v', 11)
        pocket_type = config.get('pocket_type', {}).get('v', 'rectangular')

        # 验证口袋尺寸
        if pocket_width <= 0 or pocket_depth <= 0:
            print(f"WARNING: Invalid pocket dimensions: width={pocket_width}, depth={pocket_depth}")
            self.back_pocket = None
            return
        
        self.back_pocket = PatchPocket(
            f'back_pocket_{tag}',
            width=pocket_width,
            depth=pocket_depth,
            pocket_type=pocket_type,
        )
        
        self._compute_pocket_position()
        self.subs.append(self.back_pocket)
    
    def _compute_pocket_position(self):
        """计算口袋位置 - 直接在2D版片上摆放"""
        if self.back_pocket is None:
            return
            
        config = self._pocket_config
        tag = self._pocket_tag
        pocket_width = config.get('pocket_width', {}).get('v', 11)
        pocket_depth = config.get('pocket_depth', {}).get('v', 11)
        length = self._pocket_length
        
        back_panel = self.back
        vertices = back_panel.edges.verts()
        x_min = min(v[0] for v in vertices)
        x_max = max(v[0] for v in vertices)
        y_min = min(v[1] for v in vertices)
        y_max = max(v[1] for v in vertices)
        
        # 口袋应该放在臀围线附近
        # 注意：vertices 是 post-pivot 坐标，pivot 是 crotch_end_pt = [hips + crotch_extention, length - crotch_depth_diff]
        # 臀围线在原始坐标系中是 y = length，在 post-pivot 坐标系中是：
        #   length - crotch_end_pt[1] = length - (length - crotch_depth_diff) = crotch_depth_diff
        # 所以口袋底部应该在 post-pivot 坐标系中放在 crotch_depth_diff 附近
        crotch_depth_diff = self.body['crotch_hip_diff']
        pocket_bottom = crotch_depth_diff - pocket_depth / 2

        # distance_from_side 是从侧缝向内侧偏移的距离
        # 右裤片：从 x_max（侧缝）向内侧偏移
        # 左裤片：从 x_min（侧缝）向内侧偏移
        # mirror() 会自动翻转左裤片的坐标
        if tag == 'r':
            pocket_left = x_max - 12 - pocket_width
        else:
            pocket_left = x_min + 12

        # 获取口袋面板
        pocket_panel = self.back_pocket.panel

        # 直接在2D版片上摆放口袋位置
        p0 = [pocket_left, pocket_bottom]
        p1 = [pocket_left + pocket_width, pocket_bottom]
        p2 = [pocket_left + pocket_width, pocket_bottom + pocket_depth]
        p3 = [pocket_left, pocket_bottom + pocket_depth]

        # 更新口袋面板的edges为2D版片坐标
        from pygarment import Edge, EdgeSequence
        edges = [
            Edge(p0, p1),  # edge 0: 袋口（底部）
            Edge(p1, p2),  # edge 1: 右侧边
            Edge(p2, p3),  # edge 2: 袋底（顶部）
            Edge(p3, p0),  # edge 3: 左侧边
        ]
        pocket_panel.edges = EdgeSequence(*edges).close_loop()

        # ---- 沿目标裤片外法向偏移，避免共面（REDESIGN.md要求）----
        
        # pocket_panel.edges 是在 back_panel 局部坐标系中的坐标
        # pocket_left, pocket_bottom 是口袋左下角在 back_panel 局部坐标系中的位置
        
        # 用 scipy Rotation 对象计算目标裤片的法向
        R = back_panel.rotation.as_matrix()  # 3x3 numpy 矩阵
        target_normal = R @ np.array([0.0, 0.0, 1.0])  # 1D 向量
        target_normal = target_normal.flatten()  # 确保是 1D
        surface_offset_cm = 1.5
        
        # 设置口袋 rotation = 后片 rotation
        pocket_panel.rotation = back_panel.rotation
        
        # 不设置口袋 pivot，让 pocket edges 使用 back_panel 的 post-pivot 坐标
        # 这样 pocket 的 panel_vertices 和 back_panel 的 panel_vertices 在同一个坐标系中
        
        # 计算口袋的 translation
        # back_panel 上 point [pocket_left, pocket_bottom] 的 3D 位置:
        #   back_trans + R @ ([pocket_left, pocket_bottom] - bp_start)
        # 口袋应该沿法向向外偏移 1.5cm
        back_trans = np.asarray(back_panel.translation, dtype=float).flatten()
        bp_start = back_panel.edges[0].start
        pocket_pos_in_back = np.array([
            pocket_left - bp_start[0], pocket_bottom - bp_start[1], 0.0
        ])
        pocket_translation = back_trans + R @ pocket_pos_in_back - target_normal * surface_offset_cm
        pocket_panel.translate_to(pocket_translation.tolist())

        # ---- 生成 surface_stitches ----
        # 口袋面板的边在 back_panel 局部坐标系中：
        #   edge 0: 袋口 (p0->p1, 底边)
        #   edge 1: 右侧边 (p1->p2)
        #   edge 2: 袋底 (p2->p3, 顶部)
        #   edge 3: 左侧边 (p3->p0)
        #
        # 缝合: 袋底(edge 2) + 右侧(edge 1) + 左侧(edge 3)，袋口(edge 0)不缝
        
        back_panel_name = back_panel.name
        pocket_panel_name = pocket_panel.name
        
        # target segment 使用 back_panel 的 post-pivot 坐标
        # 不设置 coordinate_space，这样 boxmeshgen.py 不会转换 target segment
        
        surface_stitches = []
        
        # edge 2: 袋底 (顶部)
        surface_stitches.append({
            'source': {'panel': pocket_panel_name, 'edge': 2},
            'target': {
                'panel': back_panel_name,
                'segment': [
                    [pocket_left + pocket_width, pocket_bottom + pocket_depth],
                    [pocket_left, pocket_bottom + pocket_depth]
                ],
            },
            'type': 'patch_pocket_surface_stitch',
        })
        
        # edge 1: 右侧边
        surface_stitches.append({
            'source': {'panel': pocket_panel_name, 'edge': 1},
            'target': {
                'panel': back_panel_name,
                'segment': [
                    [pocket_left + pocket_width, pocket_bottom],
                    [pocket_left + pocket_width, pocket_bottom + pocket_depth]
                ],
            },
            'type': 'patch_pocket_surface_stitch',
        })
        
        # edge 3: 左侧边
        surface_stitches.append({
            'source': {'panel': pocket_panel_name, 'edge': 3},
            'target': {
                'panel': back_panel_name,
                'segment': [
                    [pocket_left, pocket_bottom + pocket_depth],
                    [pocket_left, pocket_bottom]
                ],
            },
            'type': 'patch_pocket_surface_stitch',
        })
        
        pocket_panel.surface_stitches = surface_stitches

    def update_pocket_position(self):
        """在 mirror 之后重新计算口袋位置"""
        if self.back_pocket is not None:
            self._compute_pocket_position()


class Pants(BaseBottoms):
    """完整裤子类（包含左右裤片）"""
    def __init__(self, body, design, rise=None) -> None:
        super().__init__(body, design, rise=rise)
        
        self.right = PantsHalf(body, design, tag='r', rise=rise, create_front_placket=False)
        self.left = PantsHalf(body, design, tag='l', rise=rise, create_front_placket=False).mirror()
        
        # 注意：mirror() 已经正确处理了口袋的坐标翻转，不需要重新计算口袋位置
        # 如果重新计算，会导致坐标系混乱

        # ---- 门襟（仅左侧前片） ----
        self.front_placket = None
        placket_config = design.get('front_placket', {})
        if placket_config.get('enabled', {}).get('v', False):
            placket_width = placket_config.get('width', {}).get('v', 4.0)
            placket_height = placket_config.get('height', {}).get('v', 10.0)
            distance_from_waist = placket_config.get('distance_from_waist', {}).get('v', 5.0)
            self.front_placket = FrontPlacket(
                'front_placket',
                width=placket_width,
                height=placket_height,
            )
            self.front_placket.place_by_interface(
                self.front_placket.interfaces['attach'],
                self.left.front.interfaces['placket_attach'],
                gap=0,
                alignment='top'
            )
            self.front_placket.translate_by([0, -distance_from_waist, 0])
            self.front_placket.translate_by([0, 0, 0.1])
            self.subs.append(self.front_placket)
            self.left.stitching_rules.append(
                (self.front_placket.interfaces['attach'], self.left.front.interfaces['placket_attach'])
            )

        # ---- 左右裤片的缝合关系 ----
        # PantsHalf不缝合任何东西，Pants负责所有缝合
        # 使用独立的缝合规则，避免Interface.from_multiple导致的顶点冲突
        # 注意：设置right_wrong=True使swap=False，避免顶点范围被反转导致交叉线
        self.stitching_rules = pyg.Stitches(
            (self.right.front.interfaces['outside'], self.right.back.interfaces['outside']),   # 右裤片侧缝
            (self.left.front.interfaces['outside'], self.left.back.interfaces['outside']),     # 左裤片侧缝
            (self.right.front.interfaces['crotch'], self.left.front.interfaces['crotch']),     # 前裆缝合
            (self.right.back.interfaces['crotch'], self.left.back.interfaces['crotch']),       # 后裆缝合
            (self.right.front.interfaces['inside'], self.right.back.interfaces['inside']),     # 右裤片下裆缝合（前片后片）
            (self.left.front.interfaces['inside'], self.left.back.interfaces['inside']),       # 左裤片下裆缝合（前片后片）
        )
        
        # 设置right_wrong=True使swap=False，避免顶点范围被反转导致交叉线
        for rule in self.stitching_rules.rules:
            rule.int1.right_wrong = [True] * len(rule.int1.right_wrong)
            rule.int2.right_wrong = [True] * len(rule.int2.right_wrong)

        self.interfaces = {
            'top': pyg.Interface.from_multiple(
                self.right.interfaces['top'],
                self.left.interfaces['top']),
            'crotch': pyg.Interface.from_multiple(
                self.right.interfaces['crotch'],
                self.left.interfaces['crotch']),
            'outside': pyg.Interface.from_multiple(
                self.right.interfaces['outside'],
                self.left.interfaces['outside']),
            'inside': pyg.Interface.from_multiple(
                self.right.interfaces['inside'],
                self.left.interfaces['inside']),
            'bottom': pyg.Interface.from_multiple(
                self.right.interfaces['bottom'],
                self.left.interfaces['bottom'])
        }

    def get_rise(self):
        return self.right.get_rise()
    
    def length(self):
        return self.right.length()